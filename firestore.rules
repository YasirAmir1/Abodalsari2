rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /app_state/{stateId} {
      allow read, write: if true;
    }
    match /system_state/{stateId} {
      allow read, write: if true;
    }
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
